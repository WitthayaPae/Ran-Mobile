<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ran.native"
    android:versionCode="89"
    android:versionName="V067">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!--  The launcher installs the APK it is offered by the signed manifest.
          Nothing else in the app installs anything, and the bytes are checked
          against a hash the manifest signature covers before the installer
          ever sees them. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!--  Only ever used to find a pre-private-root install under /sdcard/ran and
          move it, which saves that player a 1.7 GB re-download. The game itself
          needs no storage permission: its data lives in this app own external
          files directory. Nothing blocks on it - see RanLauncher.onCreate. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- So the launcher can hand the player a new APK when the manifest's
         minApk is above this build. Data patching cannot fix a stale packet
         layout, so that case has to be an install, not a download. -->

    <!-- android:debuggable is deliberately absent.
         A debuggable build lets any user run-as the package, read everything it
         stores and attach a debugger to it, which is not something to hand out
         with the APK. Nothing in the development loop needs it: logcat, install,
         screencap, input and the /sdcard diagnostic switches all work without.
         Build with DEBUGGABLE=1 ./build-apk.sh when a debugger is genuinely
         needed - that adds the flag to a temporary copy of this file.

         allowBackup=false: with it on, adb backup pulls the app's private
         data off the device without root. -->
    <application
        android:label="Ran Legacy M"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- RanLauncher runs first: it reconciles /sdcard/ran against the
             patch manifest and only then starts the game. NativeActivity is
             NOT exported: an exported one lets any app on the device start the
             game directly, skipping the update check and the signed manifest
             with it. The login scripts go through the launcher instead. -->
        <activity android:name="com.ran.launcher.RanLauncher"
            android:label="Ran Legacy M"
            android:theme="@style/RanSplash"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|keyboard|navigation|uiMode|density"
            android:screenOrientation="sensorLandscape"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="com.ran.launcher.RanActivity"
            android:label="Ran Legacy M"
            android:theme="@style/RanSplash"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|keyboard|navigation|uiMode|density"
            android:windowSoftInputMode="adjustNothing"
            android:screenOrientation="sensorLandscape"
            android:exported="false">
            <!-- tells NativeActivity which .so to load -->
            <meta-data android:name="android.app.lib_name" android:value="ran" />
        </activity>
    </application>
</manifest>
