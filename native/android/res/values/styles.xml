<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="RanSplash" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>

    <!--  The game window starts translucent so the launcher shows through it.

          Android hands the starting window back as soon as this activity has a
          window, ~80 ms before the client has an EGL context and can draw. An
          opaque window with nothing in it is black, and that black frame is
          what made the patch page look like it vanished. The window cannot be
          given content any earlier - see the note in RanActivity - so instead
          it is see-through until there is some, and the launcher underneath
          stays up to be seen. RanActivity turns it opaque again and dismisses
          the launcher on the first present.                                   -->
    <style name="RanGame" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
