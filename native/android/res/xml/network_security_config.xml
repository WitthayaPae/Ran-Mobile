<?xml version="1.0" encoding="utf-8"?>
<!--  Cleartext is off everywhere except loopback.

      The patch host is HTTPS (https://ran-legacy-m.com/launcher_mobile/,
      Cloudflare), so the old exception for 143.14.11.244 is gone: the app has
      no reason to speak plain HTTP to any real host.

      Loopback stays for testing only: `adb reverse` plus a .patchbase override
      points the launcher at a patch server on the dev machine without
      rebuilding the APK. Nothing outside the device can answer on it. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
