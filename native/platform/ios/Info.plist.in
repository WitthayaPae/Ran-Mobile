<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>            <string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
    <key>CFBundleIdentifier</key>            <string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
    <key>CFBundleName</key>                  <string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
    <key>CFBundleDisplayName</key>           <string>Ran Legacy M</string>
    <key>CFBundlePackageType</key>           <string>APPL</string>
    <key>CFBundleShortVersionString</key>    <string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
    <key>CFBundleVersion</key>               <string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
    <key>LSRequiresIPhoneOS</key>            <true/>
    <key>MinimumOSVersion</key>              <string>13.0</string>

    <!--  The client runs landscape only: every UI rect in Gui.rcc is authored
          against a landscape frame, and the engine is not built to be resized
          mid-frame - the same reason windowSoftInputMode is adjustNothing on
          Android.  -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UIRequiresFullScreen</key>          <true/>
    <key>UIStatusBarHidden</key>             <true/>
    <key>UIViewControllerBasedStatusBarAppearance</key> <false/>

    <!--  The patch host is HTTPS (ran-legacy-m.com), which App Transport
          Security allows as it stands, so the old NSAllowsArbitraryLoads
          exception for plain http://143.14.11.244 is gone. Local networking
          stays allowed for testing against a patch server on the dev machine.
          The game server itself is a raw socket, which ATS does not govern. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key> <true/>
    </dict>

    <!--  The launch screen, without a storyboard file: a storyboard has to be
          compiled by ibtool, which would put a Mac-only step in the middle of
          the CMake build for a screen that is on screen for one frame. The
          UILaunchScreen dictionary (iOS 13+) needs no file at all.

          An EMPTY dictionary, with no UIColorName: that key names a colour
          in an asset catalogue, and there is no catalogue here - an empty
          string names nothing and is a plist the installer can reject. The
          screen is the system background for one frame, then RanSplash_Begin
          draws the boot art over it. Same handover as Android's
          bootcover.bin.  -->
    <key>UILaunchScreen</key>
    <dict/>
    <!--  Loose icon files rather than an asset catalog: a catalog has to be
          compiled by actool, which is Xcode-only, and the icons are generated
          on the machine the artwork is on (make-ios-icons.js). Enough for
          development and TestFlight. An App Store submission also wants a
          1024px marketing icon in a catalog.  -->
    <key>CFBundleIconFiles</key>
    <array>
        <string>AppIcon-20</string>
        <string>AppIcon-29</string>
        <string>AppIcon-40</string>
        <string>AppIcon-58</string>
        <string>AppIcon-60</string>
        <string>AppIcon-76</string>
        <string>AppIcon-80</string>
        <string>AppIcon-87</string>
        <string>AppIcon-120</string>
        <string>AppIcon-152</string>
        <string>AppIcon-167</string>
        <string>AppIcon-180</string>
    </array>

    <!--  Documents/ is where RanIOS_DiagRoot puts the diagnostic flags, the
          dumps and ran.log. These two keys are what make that directory
          reachable from outside the app - through Files.app on the device, and
          through iTunes/Finder file sharing over USB, which is the only way to
          read a log off an iPhone from a Windows machine.

          A store build would drop both: they expose the directory to the
          player, and nothing there is meant for them.  -->
    <key>UIFileSharingEnabled</key>                  <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>     <true/>

    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
        <string>opengles-3</string>
    </array>
</dict>
</plist>
