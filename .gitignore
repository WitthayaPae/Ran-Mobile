# ---------------------------------------------------------------- build output
# The native build tree — several GB of object files, .so and packaged APKs.
native/out/
out/
**/obj/
*.o
*.obj
*.a
*.so
*.apk
*.idsig
*.exe
*.pdb
*.ilk
*.exp
*.lib

# ------------------------------------------------------------- game content
# Extracted/converted client assets and the frozen Unity project. This is game
# data, not port source: it is reproduced from the retail client by the tools in
# tools/rcc-extract, and it does not belong in version control.
assets/
unity/
build/
client/data/

# Generated struct-layout dumps. Regenerate with tools/layout-probe — they are
# a few megabytes of derived text and change with every compiler update.
native/layout/*.txt

# ------------------------------------------------------------------ captures
# Device screenshots and crops used while diagnosing. Thousands of them, all
# disposable; the ones worth keeping are described in STATUS.md instead.
*.png
*.jpg
*.jpeg
*.bmp
*.dds
*.tga
!native/third_party/**/doc/*.png

# --------------------------------------------------------------------- logs
*.log
*.output
logcat*.txt
tombstone*

# ------------------------------------------------------------------ secrets
# Signing material. build-apk.sh expects a debug keystore here; generate your
# own with keytool rather than sharing one.
*.keystore
*.jks

# ------------------------------------------------------------------ archives
*.tgz
*.tar.gz
*.zip
*.7z
*.rcc

# --------------------------------------------------------------------- scratch
*.tmp
*.bak
*.bak_*
*.orig
*~
.DS_Store
Thumbs.db

# Generated by tools/layout-probe — regenerate with build.cmd / build-structs.js
native/layout/*.dump
tools/layout-probe/layout.json
tools/layout-probe/structs.gen.inc

# Compiler error logs from the layout probe
*.err
tools/patch/keys/

# ...except the iOS app icons. They are source, not output: CFBundleIconFiles
# names them and nothing regenerates them. The bundle shipped without any icon
# until this line existed.
!native/platform/ios/icons/*.png

# ...and the patch page's art, for the same reason. These are the four files
# the Android launcher carries in res/drawable-nodpi, copied into the iOS
# bundle: the patcher is what downloads Gui.rcc, so the page that shows the
# download cannot read its art from there. Ignored by *.png, the runner built
# a bundle without them and the page fell back to bare text.
!native/platform/ios/art/*.png

# Login credentials for the device test rig. Never committed.
native/.login
